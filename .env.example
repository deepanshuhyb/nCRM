# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgres://ncrm:ncrm@localhost:5432/ncrm
BIND_ADDR=0.0.0.0:8080
# Set to 1 to apply migrations when the API starts.
RUN_MIGRATIONS=1
# At least 32 bytes. Generate with: openssl rand -base64 48
AUTH_SECRET=replace-me-with-the-output-of-openssl-rand-base64-48
# Local development over plain http only. Leave unset (on) in production.
COOKIE_SECURE=0
# Where sign-in codes go. "log" prints them to the console (development).
CODE_SENDER=log
