# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgres://ncrm:ncrm@localhost:5432/ncrm
BIND_ADDR=0.0.0.0:8080
# Set to 1 to apply migrations when the API starts.
RUN_MIGRATIONS=1
# At least 32 bytes. Generate with: openssl rand -base64 48
AUTH_SECRET=replace-me-with-the-output-of-openssl-rand-base64-48
# Local development over plain http only. Leave unset (on) in production.
COOKIE_SECURE=0
# Where sign-in codes go.
#   log       prints them in the API's output (development only)
#   whatsapp  sends them over WhatsApp; needs the WHATSAPP_ settings below
CODE_SENDER=log

# WhatsApp (Meta Cloud API). Leave all of these out to keep WhatsApp off.
# Where to find each one is in docs/DEPLOY.md, "Sign-in codes over WhatsApp".
# WHATSAPP_TOKEN=            # a System User access token; treat like a password
# WHATSAPP_PHONE_NUMBER_ID=  # the sending number's id (digits), not the number
# WHATSAPP_OTP_TEMPLATE=ncrm_sign_in_code   # your approved authentication template
# WHATSAPP_TEMPLATE_LANG=en                 # its language code, exactly as approved
# WHATSAPP_API_BASE=https://graph.facebook.com/v21.0   # change when Meta retires v21.0

# Incoming WhatsApp messages (the inbox and the bot). Leave both out and
# the webhook stays closed; studio messages then run in test mode.
# WHATSAPP_VERIFY_TOKEN=     # any long random string; you type the same into Meta (openssl rand -hex 24)
# WHATSAPP_APP_SECRET=       # the Meta app's secret; proves a delivery is from Meta

# The bot's AI mode. Without a key, a bot set to "AI" answers with the menu.
# In AI mode the person's message, their students' names, classes and fees,
# and the timetable are sent to this provider to write each reply.
# AI_API_KEY=                # an Anthropic API key; treat like a password
# AI_MODEL=claude-haiku-5-5  # the model that writes replies
# AI_API_BASE=https://api.anthropic.com
# Exact origin(s) of the dashboard, comma-separated. State-changing requests
# from any other page are refused.
ALLOWED_ORIGINS=http://localhost:3000
# Header our reverse proxy sets to the real client IP (nginx: X-Real-IP).
# Leave unset unless every request goes through that proxy.
# CLIENT_IP_HEADER=x-real-ip
# Seconds between the background worker's housekeeping passes.
# WORKER_INTERVAL_SECS=300
