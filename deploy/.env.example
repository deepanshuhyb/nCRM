# Settings for a real server. Copy to deploy/.env and fill in.
# Never commit deploy/.env (it is in .gitignore).

# The address people open, exactly as typed, with https and no trailing slash.
PUBLIC_ORIGIN=https://app.example.com

# Database password. Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Signs sign-in codes. At least 32 bytes. Generate with: openssl rand -base64 48
# Changing it cancels codes that were just sent; people already signed in stay in.
AUTH_SECRET=

# Where sign-in codes go.
#   log       written to the API's log. Fine while you are the only user and
#             can read the log; not a way to run a studio.
#   whatsapp  sent over WhatsApp; fill in the WHATSAPP_ lines below.
CODE_SENDER=log

# WhatsApp (Meta Cloud API). See docs/DEPLOY.md, "Sign-in codes over WhatsApp".
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=ncrm_sign_in_code
WHATSAPP_TEMPLATE_LANG=en

# Incoming WhatsApp messages (the inbox and the bot). Leave both empty and
# the webhook stays closed. See docs/DEPLOY.md, "The WhatsApp inbox".
#   WHATSAPP_VERIFY_TOKEN  any long random string (openssl rand -hex 24);
#                          you type the same into Meta when subscribing
#   WHATSAPP_APP_SECRET    the Meta app's secret
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# The bot's AI mode. Empty means a bot set to "AI" answers with the menu.
# In AI mode the person's message, their students' names, classes and
# fees, and the timetable are sent to Anthropic to write each reply.
AI_API_KEY=
AI_MODEL=claude-haiku-5-5

# Seconds between the worker's housekeeping passes.
WORKER_INTERVAL_SECS=300
